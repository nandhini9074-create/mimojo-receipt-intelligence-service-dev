DATABASE_URL=postgresql+psycopg://receipt:receipt@localhost:5432/receipt_intelligence

# Appended only when image_blob_url has no query string. Never stored.
BLOB_SAS_TOKEN=

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
